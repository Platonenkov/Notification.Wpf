<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Notification.Maui.Sample.Pages.AsyncApiPage"
             Title="Async API Demo">
    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">
            <Label Text="Async API Demo" FontSize="22" FontAttributes="Bold" />
            <BoxView HeightRequest="1" Color="Gray" />

            <!-- Demo 1: ShowAsync simple -->
            <Frame BorderColor="LightGray" CornerRadius="6" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="1. ShowAsync — simple (returns close reason)" FontAttributes="Bold" />
                    <Label Text="Awaits notification close and shows the Reason." TextColor="Gray" FontSize="12" />
                    <HorizontalStackLayout Spacing="8">
                        <Button x:Name="BtnAsyncSuccess" Text="ShowAsync (Success)" Clicked="OnAsyncSuccess"
                                BackgroundColor="LimeGreen" TextColor="White" />
                        <Button x:Name="BtnAsyncInfo" Text="ShowAsync (Info)" Clicked="OnAsyncInfo"
                                BackgroundColor="CornflowerBlue" TextColor="White" />
                    </HorizontalStackLayout>
                    <Label x:Name="LblAsyncResult" Text="(result will appear here)"
                           TextColor="#2196F3" FontFamily="Courier New" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

            <!-- Demo 2: ShowDialogAsync 2 buttons -->
            <Frame BorderColor="LightGray" CornerRadius="6" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="2. ShowDialogAsync — 2 buttons (Delete / Cancel)" FontAttributes="Bold" />
                    <Label Text="Dialog with two action buttons. Displays the chosen ButtonId." TextColor="Gray" FontSize="12" />
                    <Button x:Name="BtnDialog2" Text="Delete / Cancel Dialog" Clicked="OnDialog2Buttons"
                            BackgroundColor="OrangeRed" TextColor="White" />
                    <Label x:Name="LblDialog2Result" Text="(result will appear here)"
                           TextColor="#2196F3" FontFamily="Courier New" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

            <!-- Demo 3: ShowDialogAsync 3 buttons + fallback -->
            <Frame BorderColor="LightGray" CornerRadius="6" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="3. ShowDialogAsync — 3 buttons + NotificationDialogFallback" FontAttributes="Bold" />
                    <Label Text="MAUI shows every button in a native action sheet, so all three appear and the fallback does not apply (it only matters on button-limited platforms). Pick any option to see its ButtonId." TextColor="Gray" FontSize="12" />
                    <Label Text="Fallback:" FontSize="13" />
                    <Picker x:Name="PkrFallback" Title="Select Fallback">
                        <Picker.Items>
                            <x:String>ShowFirstAffirmative — show the first Affirmative button</x:String>
                            <x:String>SkipSilently — skip, result Reason = Timeout</x:String>
                            <x:String>Throw — throw NotSupportedException</x:String>
                        </Picker.Items>
                        <Picker.SelectedIndex>0</Picker.SelectedIndex>
                    </Picker>
                    <Button x:Name="BtnDialog3" Text="Yes / No / Maybe Dialog" Clicked="OnDialog3Buttons"
                            BackgroundColor="DarkSlateBlue" TextColor="White" />
                    <Label x:Name="LblDialog3Result" Text="(result will appear here)"
                           TextColor="#2196F3" FontFamily="Courier New" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

            <!-- Demo 4: CancellationToken -->
            <Frame BorderColor="LightGray" CornerRadius="6" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="4. CancellationToken — cancel a pending notification" FontAttributes="Bold" />
                    <Label Text="Shows a 10-second snackbar. Press Cancel to dismiss via CancellationToken → Reason = Cancelled." TextColor="Gray" FontSize="12" />
                    <HorizontalStackLayout Spacing="8">
                        <Button x:Name="BtnStartCt" Text="Start (10 sec)" Clicked="OnStartCancellable"
                                BackgroundColor="Teal" TextColor="White" />
                        <Button x:Name="BtnCancelCt" Text="Cancel" Clicked="OnCancelCancellable"
                                IsEnabled="False" BackgroundColor="DarkRed" TextColor="White" />
                    </HorizontalStackLayout>
                    <Label x:Name="LblCtResult" Text="(result will appear here)"
                           TextColor="#2196F3" FontFamily="Courier New" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

            <BoxView HeightRequest="1" Color="Gray" />
            <Button Text="← Back to Main" Clicked="OnBack" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
